{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Install/Update CMAKE",
            "type": "shell",
            "command": "mkdir -p build && cd build && cmake ..",
            "group": "build",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
			"label": "Compile autogenerated docs",
			"type": "shell",
			"command": "python3 src/utils/update_cli_docs.py",
			"problemMatcher": [],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
        {
            "label": "Build MAMBAH743_2022B",
            "type": "shell",
            "command": "make MAMBAH743_2022B",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}/build"
            }
        }
        ,
        {
            "label": "CMAKE Update",
            "type": "shell",
            "command": "cmake ..",
            "group": "build",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}/build"
            }
        }
    ]
}